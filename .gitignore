*.msm
*.msp

### Linux ###
# Linux specific temp / cache files
*~

# Temporary files which can be created if a process still has a handle open of a deleted file
.fuse_hidden*

# System volume information
.directory

# Services
.Trash-*

# NFS directory caches
.nfs*

