### Terraform ###
# Local .terraform directories
.terraform/
**/.terraform/*
.terraform.lock.hcl

# .tfstate files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Exclude all .tfvars files, which might contain sensitive data
*.tfvars
*.tfvars.json
!example.tfvars

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Include override files you do want to commit using negated pattern
# !example_override.tf

# Terraform plan files
*.tfplan

